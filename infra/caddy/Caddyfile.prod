{
	local_certs
	on_demand_tls {
		ask http://api:8080/interno/tls/autorizar
	}
}

(cabeceras_seguras) {
	header {
		>Strict-Transport-Security "max-age=31536000; includeSubDomains"
		>X-Content-Type-Options "nosniff"
		>Referrer-Policy "strict-origin-when-cross-origin"
	}
}

(cabeceras_frontend) {
	header >Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://*.api.shapi.localhost; frame-ancestors 'none'"
}

(ocultar_interno) {
	@interno path /interno /interno/*
	handle @interno {
		respond 404
	}
}

https://shapi.localhost {
	import cabeceras_seguras
	import cabeceras_frontend
	import ocultar_interno

	handle /api/* {
		reverse_proxy api:8080
	}

	handle {
		root * /srv/panel
		try_files {path} /index.html
		file_server
	}
}

https://*.shapi.localhost {
	import cabeceras_seguras
	import cabeceras_frontend
	import ocultar_interno

	handle /api/portal/* {
		reverse_proxy api:8080 {
			header_up Host {http.request.host}
		}
	}

	handle {
		root * /srv/portal
		try_files {path} /index.html
		file_server
	}
}

https://*.api.shapi.localhost {
	import cabeceras_seguras
	import ocultar_interno
	reverse_proxy compuerta:8080
}

https://correo.shapi.localhost {
	import cabeceras_seguras
	import ocultar_interno
	reverse_proxy mailpit:8025
}

https:// {
	import cabeceras_seguras
	import ocultar_interno
	tls {
		on_demand
	}
	reverse_proxy compuerta:8080
}

http:// {
	redir https://{host}{uri} permanent
}
